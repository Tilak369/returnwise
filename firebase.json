{
  "hosting": {
    "public": "web",
    "ignore": ["firebase.json", "**/.*", "test/**", "package.json", "seed.mjs"],
    "cleanUrls": false,
    "headers": [
      { "source": "**/*.@(js|css|html)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
